{
    "manufacturer": "waveshare",
    "type": "apple-lamp-ov2640",
    "target": "esp32s3",
    "builds": [
        {
            "name": "apple-lamp-ov2640-edge-runtime",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": true
            },
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_APPLE_LAMP_OV2640=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_ESP_CONSOLE_SECONDARY_NONE=y",
                "CONFIG_USE_DEVICE_AEC=n",
                "CONFIG_USE_SERVER_AEC=n",
                "CONFIG_APPLE_LAMP_LOCAL_EXECUTOR=y",
                "CONFIG_APPLE_LAMP_UART_PROBE=y",
                "CONFIG_COMPILER_CXX_EXCEPTIONS=y",
                "CONFIG_APPLE_LAMP_HARDWARE_MOTION=y",
                "CONFIG_APPLE_LAMP_TWIN_WEB=y",
                "CONFIG_APPLE_LAMP_OMNI_REALTIME=y",
                "CONFIG_APPLE_LAMP_EDGE_RUNTIME=y",
                "CONFIG_MBEDTLS_HARDWARE_AES=n"
            ]
        }
    ]
}