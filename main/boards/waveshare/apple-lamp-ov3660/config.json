{
    "manufacturer": "waveshare",
    "type": "apple-lamp-ov3660",
    "target": "esp32s3",
    "builds": [
        {
            "name": "apple-lamp-ov3660",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": true
            },
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_APPLE_LAMP_OV3660=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_ESP_CONSOLE_SECONDARY_NONE=y",
                "CONFIG_USE_DEVICE_AEC=n",
                "CONFIG_USE_SERVER_AEC=n",
                "CONFIG_APPLE_LAMP_LOCAL_EXECUTOR=n",
                "CONFIG_APPLE_LAMP_UART_PROBE=n",
                "CONFIG_COMPILER_CXX_EXCEPTIONS=n"
            ]
        },
        {
            "name": "apple-lamp-ov3660-local-readonly",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": true
            },
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_APPLE_LAMP_OV3660=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_ESP_CONSOLE_SECONDARY_NONE=y",
                "CONFIG_USE_DEVICE_AEC=n",
                "CONFIG_USE_SERVER_AEC=n",
                "CONFIG_APPLE_LAMP_LOCAL_EXECUTOR=y",
                "CONFIG_APPLE_LAMP_UART_PROBE=y",
                "CONFIG_COMPILER_CXX_EXCEPTIONS=y"
            ]
        }
    ]
}
